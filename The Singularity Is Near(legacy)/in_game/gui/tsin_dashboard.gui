# GENERATED registered management window.
window = {
name = "tsin_dashboard_window"
layer = topbar
parentanchor = center
widgetanchor = center
size = { 1360 820 }
movable = yes
allow_outside = yes
datacontext = "[GetPlayer]"
visible = "[And(GetPlayer.IsValid, GetVariableSystem.Exists('tsin_ui_dashboard_open'))]"
widget = { size = { 100% 100% } using = bg_window_default_alt
widget = { parentanchor = right position = { -5 5 } size = { 40 40 } ui_direction_button_holder_right = {} button_close_alt = { blockoverride "close_on_action" {
on_action = "[GetVariableSystem.Clear('tsin_ui_dashboard_open')]"
} } }
vbox = { using = window_margin_alt
window_header_alt = { blockoverride "header_text" { text = "TSIN_UI_TITLE" } }
header_main_tabs = { blockoverride "content" {
button_main_tab_alt = {
using = layoutpolicy_expanding
text = "TSIN_UI_TAB_OVERVIEW"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_open', 'yes')]"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_tab', 'overview')]"
down = "[GetVariableSystem.HasValue('tsin_ui_dashboard_tab', 'overview')]"
}
button_main_tab_alt = {
using = layoutpolicy_expanding
text = "TSIN_UI_TAB_ECONOMY"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_open', 'yes')]"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_tab', 'economy')]"
down = "[GetVariableSystem.HasValue('tsin_ui_dashboard_tab', 'economy')]"
}
button_main_tab_alt = {
using = layoutpolicy_expanding
text = "TSIN_UI_TAB_SOCIETY"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_open', 'yes')]"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_tab', 'society')]"
down = "[GetVariableSystem.HasValue('tsin_ui_dashboard_tab', 'society')]"
}
button_main_tab_alt = {
using = layoutpolicy_expanding
text = "TSIN_UI_TAB_FINANCE"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_open', 'yes')]"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_tab', 'finance')]"
down = "[GetVariableSystem.HasValue('tsin_ui_dashboard_tab', 'finance')]"
}
button_main_tab_alt = {
using = layoutpolicy_expanding
text = "TSIN_UI_TAB_CRISES"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_open', 'yes')]"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_tab', 'crises')]"
down = "[GetVariableSystem.HasValue('tsin_ui_dashboard_tab', 'crises')]"
}
button_main_tab_alt = {
using = layoutpolicy_expanding
text = "TSIN_UI_TAB_RESEARCH"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_open', 'yes')]"
onclick = "[GetVariableSystem.Set('tsin_ui_dashboard_tab', 'research')]"
down = "[GetVariableSystem.HasValue('tsin_ui_dashboard_tab', 'research')]"
}
} }
hbox = { layoutpolicy_horizontal = expanding margin = { 8 4 } spacing = 10
text_single = { using = Font_Size_Medium text = "TSIN_UI_DATE" }
text_single = { visible = "[GetPlayer.MakeScope.GetVariable('tsin_statistics_year').IsSet]" using = Font_Size_Medium text = "[GetPlayer.MakeScope.GetVariable('tsin_statistics_year').GetValue|0]" }
text_single = { visible = "[Not(GetPlayer.MakeScope.GetVariable('tsin_statistics_year').IsSet )]" using = Font_Size_Medium text = "TSIN_UI_NO_DATE" }
}
vbox = { using = layoutpolicy_expanding using = bg_main_inner_alt
scrollarea = { size = { 1320 620 } scrollbarpolicy_horizontal = always_off scrollbar_vertical = { using = Scrollbar_Vertical } scrollwidget = { vbox = { spacing = 10 margin = { 10 8 }
vbox = { visible = "[GetVariableSystem.HasValue('tsin_ui_dashboard_tab', 'overview')]" spacing = 10
flowcontainer = { layoutpolicy_horizontal = expanding spacing = 8
widget = { size = { 234 40 } datacontext = "[GetGenericAction('tsin_survey_domestic')]"
button_regular = {
    size = { 234 40 }
    action_tooltip = {
        title = "TSIN_UI_LINK_SURVEY_DOMESTIC"
        on_action = "[PerformGenericAction(GenericAction.Self)]"
        on_action = "[GetVariableSystem.Clear('tsin_ui_dashboard_open')]"
    }
    text_single = { size = { 226 36 } parentanchor = center autoresize = no maximumsize = { 226 36 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "TSIN_UI_LINK_SURVEY_DOMESTIC" }
}
}
widget = { size = { 234 40 } datacontext = "[GetGenericAction('tsin_survey_world')]"
button_regular = {
    size = { 234 40 }
    action_tooltip = {
        title = "TSIN_UI_LINK_SURVEY_WORLD"
        on_action = "[PerformGenericAction(GenericAction.Self)]"
        on_action = "[GetVariableSystem.Clear('tsin_ui_dashboard_open')]"
    }
    text_single = { size = { 226 36 } parentanchor = center autoresize = no maximumsize = { 226 36 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "TSIN_UI_LINK_SURVEY_WORLD" }
}
}
button_regular = {
    size = { 234 40 }
    action_tooltip = {
        title = "TSIN_UI_LINK_COUNTRY_COMPARE"
        on_action = "[GetVariableSystem.Set('tsin_ui_country_compare_open', 'yes')]"
        on_action = "[GetVariableSystem.Clear('tsin_ui_dashboard_open')]"
    }
    text_single = { size = { 226 36 } parentanchor = center autoresize = no maximumsize = { 226 36 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "TSIN_UI_LINK_COUNTRY_COMPARE" }
}
button_regular = {
    size = { 234 40 }
    action_tooltip = {
        title = "TSIN_UI_LINK_TREATIES"
        on_action = "[GetVariableSystem.Set('tsin_ui_treaties_open', 'yes')]"
        on_action = "[GetScriptedGui('tsin_tr_init_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        on_action = "[GetVariableSystem.Clear('tsin_ui_dashboard_open')]"
    }
    text_single = { size = { 226 36 } parentanchor = center autoresize = no maximumsize = { 226 36 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "TSIN_UI_LINK_TREATIES" }
}
}
