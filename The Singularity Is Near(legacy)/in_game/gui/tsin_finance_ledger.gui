layoutpolicy_horizontal = expanding
using = bg_paper_card
using = bg_cabinet_card_frame
margin = { 10 8 }
spacing = 6
tooltip = "TSIN_LEDGER_FUND_NOTE"
tagtooltip_enabled = yes
text_single = {
