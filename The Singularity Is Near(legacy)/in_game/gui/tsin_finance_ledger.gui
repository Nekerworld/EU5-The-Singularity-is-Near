types TSINLedger {
type tsin_money_panel = scrollarea {
using = layoutpolicy_expanding
scrollbarpolicy_horizontal = always_off
autoresizescrollarea = no
scrollbar_vertical = { using = Scrollbar_Vertical }
scrollwidget = {
vbox = {
using = layoutpolicy_expanding
using = bg_secondary_inner_alt
using = bg_secondary_inner_image_alt
blockoverride "image" { texture = "gfx/interface/economy/bg_credit.dds" }
margin = { 10 12 }
spacing = 10
hbox = {
layoutpolicy_horizontal = expanding
spacing = 8
text_single = {
autoresize = yes
fontsize = 20
text = "TSIN_LEDGER_MONEY"
using = Font_Type_Headers
default_format = "#yellow_titles"
}
expand = {}
button_regular = {
size = { 28 28 }
tooltip = "TSIN_LEDGER_TECH_HELP"
tagtooltip_enabled = yes
text_single = {
size = { 24 24 }
parentanchor = center
autoresize = no
align = center|nobaseline
fontsize = 14
raw_text = "?"
}
}
button_regular = {
size = { 28 28 }
tooltip = "TSIN_LEDGER_REFORM_NOTE"
tagtooltip_enabled = yes
text_single = {
size = { 24 24 }
parentanchor = center
autoresize = no
align = center|nobaseline
fontsize = 14
raw_text = "?"
}
}
}
hbox = {
layoutpolicy_horizontal = expanding
spacing = 8
text_single = { autoresize = yes fontsize = 15 text = "TSIN_LEDGER_CURRENCY_PICK" using = Font_Type_Headers }
hbox = {
visible = "[Not(LateralView.Vars.Exists('tsin_edit_currency'))]"
spacing = 6
text_single = { autoresize = yes fontsize = 18 raw_text = "[Select_CString(GetVariableSystem.Exists(Concatenate('tsin_cur_', GetPlayer.GetTag)), GetVariableSystem.Get(Concatenate('tsin_cur_', GetPlayer.GetTag)), Select_CString(GetPlayer.MakeScope.GetVariable('tsin_currency_label').IsSet, GetPlayer.MakeScope.GetVariable('tsin_currency_label').GetFlagName, GetPlayer.Custom('tsin_currency_name')))]" }
button = {
size = { 28 28 }
tooltip = "TSIN_LEDGER_CURRENCY_RENAME"
tagtooltip_enabled = yes
action_tooltip = { title = "TSIN_LEDGER_CURRENCY_RENAME" on_action = "[LateralView.Vars.Toggle('tsin_edit_currency')]" }
icon = { size = { 22 22 } parentanchor = center texture = "gfx/interface/buttons/flats/rename_new.dds" texture_density = 2 }
}
button_regular = { size = { 110 32 }
enabled = "[GetScriptedGui('tsin_ledger_currency_reset').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
action_tooltip = { title = "TSIN_LEDGER_CURRENCY_RESET"
on_action = "[GetVariableSystem.Clear(Concatenate('tsin_cur_', GetPlayer.GetTag))]"
on_action = "[GetScriptedGui('tsin_ledger_currency_reset').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
text_single = { size = { 104 28 } parentanchor = center autoresize = no maximumsize = { 104 28 } fontsize = 11 align = center|nobaseline text = "TSIN_LEDGER_CURRENCY_RESET" } }
button_regular = {
size = { 28 28 }
tooltip = "TSIN_LEDGER_CURRENCY_HELP"
tagtooltip_enabled = yes
text_single = {
size = { 24 24 }
parentanchor = center
autoresize = no
align = center|nobaseline
fontsize = 14
raw_text = "?"
}
}
}
hbox = {
visible = "[LateralView.Vars.Exists('tsin_edit_currency')]"
layoutpolicy_horizontal = expanding
spacing = 6
editbox = {
name = "tsin_currency_name_edit"
using = layoutpolicy_expanding
size = { -1 34 }
fontsize = 16
align = left|nobaseline
maxcharacters = 32
multiline = no
focus_on_visible = yes
focuspolicy = all
alwaystransparent = no
raw_text = "[Select_CString(GetVariableSystem.Exists(Concatenate('tsin_cur_', GetPlayer.GetTag)), GetVariableSystem.Get(Concatenate('tsin_cur_', GetPlayer.GetTag)), Select_CString(GetPlayer.MakeScope.GetVariable('tsin_currency_label').IsSet, GetPlayer.MakeScope.GetVariable('tsin_currency_label').GetFlagName, GetPlayer.Custom('tsin_currency_name')))]"
oneditingfinished_with_changes = "[GetVariableSystem.Set(Concatenate('tsin_cur_', GetPlayer.GetTag), PdxGuiEditboxGetText(PdxGuiWidget.Self))]"
oneditingfinished_with_changes = "[ExecuteConsoleCommand(Concatenate('effect c:', Concatenate(GetPlayer.GetTag, Concatenate(' = { set_variable = { name = tsin_currency_label value = "', Concatenate(PdxGuiEditboxGetText(PdxGuiWidget.Self), '" } } }'))))]"
oneditingfinished = "[LateralView.Vars.Clear('tsin_edit_currency')]"
onfocusout = "[LateralView.Vars.Clear('tsin_edit_currency')]"
}
}
}
vbox = {
layoutpolicy_horizontal = expanding
using = bg_paper_card
using = bg_cabinet_card_frame
margin = { 10 8 }
spacing = 6
tooltip = "TSIN_LEDGER_REFORM_NOTE"
tagtooltip_enabled = yes
text_single = {
autoresize = yes
fontsize = 15
text = "TSIN_LEDGER_MONEY"
default_format = "#yellow_titles"
using = Font_Type_Headers
}
icon_text_2rows = {
blockoverride "icon_setup" { texture = "gfx/interface/icons/flat_icons/balance/budget.dds" glow = { name = "drop_shadow" glow_radius = 3 color = { 0.0 0.0 0.0 1.0 } alpha = 0.3 } }
blockoverride "top_text_setup" {
text = "TSIN_LEDGER_FX"
default_format = "#explanation_link_overview"
}
blockoverride "bottom_text_setup" {
raw_text = "[GetPlayer.MakeScope.GetVariable('tsin_fx').GetValue|2L]"
}

tooltip = "TSIN_LEDGER_FX"
tagtooltip_enabled = yes
}
icon_text_2rows = {
blockoverride "icon_setup" { texture = "gfx/interface/icons/flat_icons/balance/budget.dds" glow = { name = "drop_shadow" glow_radius = 3 color = { 0.0 0.0 0.0 1.0 } alpha = 0.3 } }
blockoverride "top_text_setup" {
text = "TSIN_LEDGER_LOCAL"
default_format = "#explanation_link_overview"
}
blockoverride "bottom_text_setup" {
raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('tsin_local_treasury')|2L]"
}

tooltip = "TSIN_LEDGER_LOCAL"
tagtooltip_enabled = yes
}
icon_text_2rows = {
blockoverride "icon_setup" { texture = "gfx/interface/icons/flat_icons/balance/budget.dds" glow = { name = "drop_shadow" glow_radius = 3 color = { 0.0 0.0 0.0 1.0 } alpha = 0.3 } }
blockoverride "top_text_setup" {
text = "TSIN_LEDGER_RATE"
default_format = "#explanation_link_overview"
}
blockoverride "bottom_text_setup" {
raw_text = "[GetPlayer.MakeScope.GetVariable('tsin_rate').GetValue|2L]"
}

tooltip = "TSIN_LEDGER_RATE"
