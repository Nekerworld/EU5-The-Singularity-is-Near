raw_text = "[GetPlayer.MakeScope.GetVariable('tsin_reserve').GetValue|2L]"
}

tooltip = "TSIN_LEDGER_RESERVE"
tagtooltip_enabled = yes
}
}
vbox = {
layoutpolicy_horizontal = expanding
using = bg_paper_card
using = bg_cabinet_card_frame
