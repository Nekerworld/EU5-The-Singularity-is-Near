type tsin_funds_panel = scrollarea {
using = layoutpolicy_expanding
scrollbarpolicy_horizontal = always_off
autoresizescrollarea = no
scrollbar_vertical = { using = Scrollbar_Vertical }
scrollwidget = {
vbox = {
using = layoutpolicy_expanding
using = bg_secondary_inner_alt
using = bg_secondary_inner_image_alt
blockoverride "image" { texture = "gfx/interface/economy/bg_credit.dds" }
margin = { 10 12 }
spacing = 10
hbox = {
layoutpolicy_horizontal = expanding
spacing = 8
text_single = {
autoresize = yes
fontsize = 20
text = "TSIN_LEDGER_FUNDS"
using = Font_Type_Headers
default_format = "#yellow_titles"
}
expand = {}
button_regular = {
size = { 28 28 }
tooltip = "TSIN_LEDGER_TECH_HELP"
tagtooltip_enabled = yes
text_single = {
size = { 24 24 }
parentanchor = center
autoresize = no
align = center|nobaseline
fontsize = 14
raw_text = "?"
}
}
button_regular = {
size = { 28 28 }
tooltip = "TSIN_LEDGER_FUND_NOTE"
tagtooltip_enabled = yes
text_single = {
size = { 24 24 }
parentanchor = center
autoresize = no
align = center|nobaseline
fontsize = 14
raw_text = "?"
}
}
}
vbox = {
layoutpolicy_horizontal = expanding
using = bg_paper_card
using = bg_cabinet_card_frame
margin = { 10 8 }
spacing = 6
tooltip = "TSIN_LEDGER_FUND_NOTE"
tagtooltip_enabled = yes
text_single = {
autoresize = yes
fontsize = 15
text = "TSIN_LEDGER_FUNDS"
default_format = "#yellow_titles"
using = Font_Type_Headers
}
icon_text_2rows = {
blockoverride "icon_setup" { texture = "gfx/interface/icons/flat_icons/balance/budget.dds" glow = { name = "drop_shadow" glow_radius = 3 color = { 0.0 0.0 0.0 1.0 } alpha = 0.3 } }
blockoverride "top_text_setup" {
text = "TSIN_LEDGER_INSURANCE"
default_format = "#explanation_link_overview"
}
blockoverride "bottom_text_setup" {
raw_text = "[GetPlayer.MakeScope.GetVariable('tsin_insurance').GetValue|2L]"
}

tooltip = "TSIN_LEDGER_INSURANCE"
tagtooltip_enabled = yes
}
icon_text_2rows = {
blockoverride "icon_setup" { texture = "gfx/interface/icons/flat_icons/balance/budget.dds" glow = { name = "drop_shadow" glow_radius = 3 color = { 0.0 0.0 0.0 1.0 } alpha = 0.3 } }
blockoverride "top_text_setup" {
text = "TSIN_LEDGER_PENSION"
default_format = "#explanation_link_overview"
}
blockoverride "bottom_text_setup" {
raw_text = "[GetPlayer.MakeScope.GetVariable('tsin_pension').GetValue|2L]"
}

tooltip = "TSIN_LEDGER_PENSION"
tagtooltip_enabled = yes
}
icon_text_2rows = {
blockoverride "icon_setup" { texture = "gfx/interface/icons/flat_icons/balance/budget.dds" glow = { name = "drop_shadow" glow_radius = 3 color = { 0.0 0.0 0.0 1.0 } alpha = 0.3 } }
blockoverride "top_text_setup" {
text = "TSIN_LEDGER_BENEFITS"
default_format = "#explanation_link_overview"
}
blockoverride "bottom_text_setup" {
raw_text = "[GetPlayer.MakeScope.GetVariable('tsin_pension_paid').GetValue|2L]"
}

tooltip = "TSIN_LEDGER_BENEFITS"
tagtooltip_enabled = yes
}
icon_text_2rows = {
blockoverride "icon_setup" { texture = "gfx/interface/icons/flat_icons/balance/budget.dds" glow = { name = "drop_shadow" glow_radius = 3 color = { 0.0 0.0 0.0 1.0 } alpha = 0.3 } }
blockoverride "top_text_setup" {
text = "TSIN_LEDGER_PENSION_GAP"
default_format = "#explanation_link_overview"
}
blockoverride "bottom_text_setup" {
raw_text = "[GetPlayer.MakeScope.GetVariable('tsin_pension_shortfall').GetValue|2L]"
}

tooltip = "TSIN_LEDGER_PENSION_GAP"
tagtooltip_enabled = yes
}
}
