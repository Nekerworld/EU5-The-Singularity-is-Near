 widget = { size = { 240 23 } datacontext = "[GetPlayer.MakeScope.GetVariable('tsin_wcs_display_12_country').GetCountry]"
 text_single = { size = { 235 22 } autoresize = no fontsize = 13 fontsize_min = 10 text = "[Country.GetName]" tooltipwidget = { using = CountryTooltip } } }
 text_single = { size = { 90 23 } text = "[GetPlayer.MakeScope.GetVariable('tsin_wcs_display_12_count').GetValue|0]" }
 text_single = { size = { 175 23 } text = "[GetPlayer.Custom('tsin_wcs_fmt_12_cash')]" }
 text_single = { size = { 175 23 } text = "[GetPlayer.Custom('tsin_wcs_fmt_12_proxy')]" }
 text_single = { size = { 100 23 } text = "[GetPlayer.MakeScope.GetVariable('tsin_wcs_display_12_source_year').GetValue|0]" }
}
hbox = { spacing = 8
button_regular = { size = { 145 28 } enabled = "[GetScriptedGui('tsin_wcs_prev').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 action_tooltip = { title = "TSIN_WCS_PREV" on_action = "[GetScriptedGui('tsin_wcs_prev').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 text_single = { size = { 139 26 } parentanchor = center autoresize = no fontsize = 12 fontsize_min = 8 text = "TSIN_WCS_PREV" }
}
button_regular = { size = { 145 28 } enabled = "[GetScriptedGui('tsin_wcs_next').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 action_tooltip = { title = "TSIN_WCS_NEXT" on_action = "[GetScriptedGui('tsin_wcs_next').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 text_single = { size = { 139 26 } parentanchor = center autoresize = no fontsize = 12 fontsize_min = 8 text = "TSIN_WCS_NEXT" }
}
text_single = { text = "TSIN_WCS_PAGE" }
}
} } }
} }
