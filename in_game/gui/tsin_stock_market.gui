text_single = { visible = "[Not(And(GetPlayer.MakeScope.GetVariable('tsin_stock_farm_machinery').IsSet, GetPlayer.MakeScope.GetVariable('tsin_stock_ui_levels_farm_machinery').IsSet))]" text = "TSIN_STOCK_MISSING" }
}
widget = { size = { 520 56 } datacontext = "[GetPlayer.MakeScope.GetVariable('tsin_hq_farm_machinery').GetLocation]"
vbox = { spacing = 2
text_single = { visible = "[Location.IsValid]" text = "[Location.GetName]" }
text_single = { visible = "[Not(Location.IsValid)]" text = "TSIN_STOCK_NO_HQ" }
button_regular = { size = { 180 28 }
enabled = "[Location.IsValid]"
action_tooltip = { title = "TSIN_STOCK_HQ" on_action = "[ShowLocation(Location.Self)]" }
text_single = { size = { 172 26 } parentanchor = center align = center|nobaseline autoresize = no fontsize = 12 fontsize_min = 9 text = "TSIN_STOCK_HQ" }
}
}
}
}
}
text_single = { maximumsize = { 540 -1 } multiline = yes fontsize = 11 text = "TSIN_STOCK_HELP" }
}
}
}
