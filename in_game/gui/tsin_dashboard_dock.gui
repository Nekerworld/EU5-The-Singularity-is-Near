# GENERATED registered dock.
window = {
name = "tsin_dashboard_dock"
layer = topbar
parentanchor = left|bottom
widgetanchor = left|bottom
position = { 0 0 }
size = { 210 112 }
movable = yes
allow_outside = yes
visible = "[And(GetPlayer.IsValid, Not(IsPauseMenuShown))]"
datacontext = "[GetPlayer]"
hbox = { spacing = 8 margin = { 2 2 }
button = {
    name = "tsin_ui_manage_button"
    size = { 104 104 }
    tooltip = "TSIN_UI_OPEN"
    down = "[GetVariableSystem.Exists('tsin_ui_dashboard_open')]"
    action_tooltip = {
        click_type = left
        click_mode = single
        click_modifier = default
        title = "TSIN_UI_OPEN"
        on_action = "[GetVariableSystem.Toggle('tsin_ui_dashboard_open')]"
        on_action = "[GetVariableSystem.Set('tsin_ui_dashboard_tab', 'overview')]"
    }
    block "button_texture" {
        texture = "gfx/interface/buttons/round_button_texture_alt.dds"
        texture_density = 2
    }
    modify_texture = { using = color_new_gold_texture blend_mode = overlay alpha = 1 }
    modify_texture = { using = overlay_stone_texture blend_mode = overlay alpha = 1 }
    block "navigational_bg" {
        background = {
            texture = "gfx/interface/buttons/bg_button_light.dds"
            texture_density = 2
            modify_texture = { using = color_intense_brown_texture blend_mode = add }
            modify_texture = { using = color_super_dark_brown_texture blend_mode = multiply alpha = 0.6 }
        }
    }
    icon = {
        size = { 78 78 }
        parentanchor = center
        texture = "gfx/interface/icons/tsin_hud_logo.dds"
        alpha = 0.95
        alwaystransparent = yes
    }
}
tsin_ops_button = {}
}
}
