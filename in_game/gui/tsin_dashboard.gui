# GENERATED registered management window.
window = {
name = "tsin_dashboard_window"
layer = topbar
parentanchor = center
widgetanchor = center
size = { 900 660 }
movable = yes
allow_outside = yes
datacontext = "[GetPlayer]"
visible = "[And(GetPlayer.IsValid, GetVariableSystem.Exists('tsin_ui_dashboard_open'))]"
widget = { size = { 100% 100% } using = bg_window_default_alt }
widget = { parentanchor = right position = { -8 8 } size = { 40 40 } button_close_alt = { blockoverride "close_on_action" {
on_action = "[GetVariableSystem.Clear('tsin_ui_dashboard_open')]"
} } }
vbox = { position = { 24 20 } spacing = 10
text_single = { fontsize = 22 text = "TSIN_UI_TITLE" }
hbox = { spacing = 8
text_single = { text = "TSIN_UI_DATE" }
text_single = { visible = "[GetPlayer.MakeScope.GetVariable('tsin_statistics_year').IsSet]" text = "[GetPlayer.MakeScope.GetVariable('tsin_statistics_year').GetValue|0]" }
text_single = { visible = "[Not(GetPlayer.MakeScope.GetVariable('tsin_statistics_year').IsSet )]" text = "TSIN_UI_NO_DATE" }
}
hbox = { spacing = 4
button_regular = {
    size = { 136 30 }
    action_tooltip = {
        title = "TSIN_UI_TAB_OVERVIEW"
        on_action = "[GetVariableSystem.Set('tsin_ui_dashboard_open', 'yes')]"
        on_action = "[GetVariableSystem.Set('tsin_ui_dashboard_tab', 'overview')]"
    }
    text_single = { size = { 128 28 } parentanchor = center autoresize = no fontsize = 13 fontsize_min = 10 align = center|nobaseline text = "TSIN_UI_TAB_OVERVIEW" }
}
button_regular = {
    size = { 136 30 }
    action_tooltip = {
        title = "TSIN_UI_TAB_ECONOMY"
