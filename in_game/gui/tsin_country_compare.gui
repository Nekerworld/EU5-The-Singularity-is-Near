window = {
 name = "tsin_country_compare_window" layer = topbar parentanchor = center widgetanchor = center
 size = { 1040 900 } movable = yes allow_outside = yes datacontext = "[GetPlayer]"
 visible = "[And(GetPlayer.IsValid, GetVariableSystem.Exists('tsin_ui_country_compare_open'))]"
 widget = { size = { 100% 100% } using = bg_window_default_alt
 widget = { parentanchor = right position = { -5 5 } size = { 40 40 } ui_direction_button_holder_right = {} button_close_alt = { blockoverride "close_on_action" { on_action = "[GetVariableSystem.Clear('tsin_ui_country_compare_open')]" } } }
 vbox = { using = window_margin_alt
 window_header_alt = { blockoverride "header_text" { text = "TSIN_CMP_TITLE" } }
 text_single = { visible = "[Not(GetPlayer.MakeScope.GetVariable('tsin_cmp_page').IsSet)]" fontsize = 14 text = "TSIN_CMP_EMPTY" }
 vbox = { using = layoutpolicy_expanding using = bg_main_inner_alt
 scrollarea = { size = { 990 720 } scrollbarpolicy_horizontal = always_off scrollbar_vertical = { using = Scrollbar_Vertical }
 visible = "[GetPlayer.MakeScope.GetVariable('tsin_cmp_page').IsSet]"
 scrollwidget = { vbox = { spacing = 8 margin = { 10 8 }
text_single = { fontsize = 17 text = "TSIN_CMP_LIST" }
hbox = { spacing = 8 button_regular = { size = { 130 40 } enabled = "[GetScriptedGui('tsin_cmp_prev').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 action_tooltip = { title = "tsin_cmp_prev" on_action = "[GetScriptedGui('tsin_cmp_prev').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 text_single = { size = { 122 36 } parentanchor = center autoresize = no maximumsize = { 122 36 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "tsin_cmp_prev" }
} button_regular = { size = { 130 40 } enabled = "[GetScriptedGui('tsin_cmp_next').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 action_tooltip = { title = "tsin_cmp_next" on_action = "[GetScriptedGui('tsin_cmp_next').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 text_single = { size = { 122 36 } parentanchor = center autoresize = no maximumsize = { 122 36 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "tsin_cmp_next" }
} button_regular = { size = { 200 40 } enabled = "[GetScriptedGui('tsin_cmp_clear').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 action_tooltip = { title = "tsin_cmp_clear" on_action = "[GetScriptedGui('tsin_cmp_clear').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
 text_single = { size = { 192 36 } parentanchor = center autoresize = no maximumsize = { 192 36 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "tsin_cmp_clear" }
} }
hbox = { spacing = 6 text_single = { size = { 200 26 } autoresize = no fontsize = 13 fontsize_min = 9 text = "TSIN_CMP_COL_COUNTRY" }text_single = { size = { 60 26 } autoresize = no fontsize = 13 fontsize_min = 9 text = "TSIN_CMP_COL_SERIAL" }text_single = { size = { 100 26 } autoresize = no fontsize = 13 fontsize_min = 9 text = "TSIN_CMP_COL_DATE" }text_single = { size = { 140 26 } autoresize = no fontsize = 13 fontsize_min = 9 text = "TSIN_CMP_COL_POP" }text_single = { size = { 150 26 } autoresize = no fontsize = 13 fontsize_min = 9 text = "TSIN_CMP_COL_GDP" }text_single = { size = { 70 26 } autoresize = no fontsize = 13 fontsize_min = 9 text = "TSIN_CMP_COL_FIRMS" }}
