types TSINLedger {
type tsin_money_panel = scrollarea { using = layoutpolicy_expanding scrollbarpolicy_horizontal = always_off scrollbar_vertical = { using = Scrollbar_Vertical } scrollwidget = { vbox = { using = layoutpolicy_expanding using = bg_main_inner_alt using = window_main_tabs_margin_alt spacing = 8
text_single = { fontsize = 22 text = "TSIN_LEDGER_MONEY" }
text_single = { text = "TSIN_LEDGER_UNIT" }
hbox = { spacing = 8 text_single = { size = { 330 26 } text = "TSIN_LEDGER_FX" } text_single = { text = "[GetPlayer.MakeScope.GetVariable('tsin_fx').GetValue|2L]" } }
hbox = { spacing = 8 text_single = { size = { 330 26 } text = "TSIN_LEDGER_LOCAL" } text_single = { text = "[GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('tsin_local_treasury')|2L]" } }
hbox = { spacing = 8 text_single = { size = { 330 26 } text = "TSIN_LEDGER_RATE" } text_single = { text = "[GetPlayer.MakeScope.GetVariable('tsin_rate').GetValue|2L]" } }
hbox = { spacing = 8 text_single = { size = { 330 26 } text = "TSIN_LEDGER_RESERVE" } text_single = { text = "[GetPlayer.MakeScope.GetVariable('tsin_reserve').GetValue|2L]" } }
button_regular = { size = { 480 28 }
enabled = "[GetScriptedGui('tsin_ledger_suspend_gold').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
action_tooltip = { title = "TSIN_LEDGER_SUSPEND_GOLD" on_action = "[GetScriptedGui('tsin_ledger_suspend_gold').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
text_single = { parentanchor = center align = center text = "TSIN_LEDGER_SUSPEND_GOLD" } }
button_regular = { size = { 480 28 }
enabled = "[GetScriptedGui('tsin_ledger_reserve').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
action_tooltip = { title = "TSIN_LEDGER_RESERVE" on_action = "[GetScriptedGui('tsin_ledger_reserve').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
text_single = { parentanchor = center align = center text = "TSIN_LEDGER_RESERVE" } }
button_regular = { size = { 480 28 }
enabled = "[GetScriptedGui('tsin_ledger_release').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
action_tooltip = { title = "TSIN_LEDGER_RELEASE" on_action = "[GetScriptedGui('tsin_ledger_release').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
text_single = { parentanchor = center align = center text = "TSIN_LEDGER_RELEASE" } }
button_regular = { size = { 480 28 }
enabled = "[GetScriptedGui('tsin_ledger_rate_up').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
action_tooltip = { title = "TSIN_LEDGER_RATE_UP" on_action = "[GetScriptedGui('tsin_ledger_rate_up').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
text_single = { parentanchor = center align = center text = "TSIN_LEDGER_RATE_UP" } }
button_regular = { size = { 480 28 }
enabled = "[GetScriptedGui('tsin_ledger_rate_down').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
action_tooltip = { title = "TSIN_LEDGER_RATE_DOWN" on_action = "[GetScriptedGui('tsin_ledger_rate_down').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
text_single = { parentanchor = center align = center text = "TSIN_LEDGER_RATE_DOWN" } }
button_regular = { size = { 480 28 }
enabled = "[GetScriptedGui('tsin_ledger_devalue').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
action_tooltip = { title = "TSIN_LEDGER_DEVALUE" on_action = "[GetScriptedGui('tsin_ledger_devalue').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
text_single = { parentanchor = center align = center text = "TSIN_LEDGER_DEVALUE" } }
button_regular = { size = { 480 28 }
enabled = "[GetScriptedGui('tsin_ledger_redenominate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
action_tooltip = { title = "TSIN_LEDGER_REDENOMINATE" on_action = "[GetScriptedGui('tsin_ledger_redenominate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
text_single = { parentanchor = center align = center text = "TSIN_LEDGER_REDENOMINATE" } }
text_single = { maximumsize = { 520 -1 } multiline = yes text = "TSIN_LEDGER_REFORM_NOTE" }
} } }
