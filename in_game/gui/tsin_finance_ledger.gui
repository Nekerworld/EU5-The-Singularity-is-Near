types TSINLedger {
type tsin_money_panel = scrollarea { using = layoutpolicy_expanding scrollbarpolicy_horizontal = always_off scrollbar_vertical = { using = Scrollbar_Vertical } scrollwidget = { vbox = { using = layoutpolicy_expanding using = bg_main_inner_alt using = window_main_tabs_margin_alt spacing = 8
text_single = { fontsize = 22 text = "TSIN_LEDGER_MONEY" }
